{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/root/.pm2/logs/*.log",
            "log_group_name": "staging/dailyguide-api",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 180
          }
        ]
      }
    }
  }
}
